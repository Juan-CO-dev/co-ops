# SIM SANDBOX ENV — copy this file to .env.sim and fill THREE pasted values.
# .env.sim is gitignored. NEVER put prod values here. NO dashboard settings
# are changed — this is pure copy-paste from the co-ops-sim project.
#
# ── JUAN'S ERRAND (copy 3 values, change nothing) ───────────────────────────
# Supabase dashboard → co-ops-sim project (jepgzucrvklhqpthowsc):
#
#  1. Project Settings → API Keys → if you see a "Legacy API Keys" tab, use it
#     (the JWT-style keys). Reveal + copy:
#       anon        → NEXT_PUBLIC_SUPABASE_ANON_KEY
#       service_role → SUPABASE_SERVICE_ROLE_KEY
#     (If there is NO legacy tab and only "publishable"/"secret" keys exist,
#     paste those instead in the same two slots and tell CC — plan B kicks in.)
#
#  2. Project Settings → JWT Keys (the page with the ECC/signing-keys stuff):
#     IGNORE all the signing-key/ECC options. Find the "Legacy JWT Secret"
#     section, reveal + copy the secret string → SIM_LEGACY_JWT_SECRET below.
#     Do NOT rotate it, do NOT create new keys, do NOT migrate anything.
#
# That's it. The launcher derives AUTH_JWT_SECRET from the legacy secret
# automatically (the app signs hex-decoded; PostgREST verifies the same bytes).

NEXT_PUBLIC_SUPABASE_URL=https://jepgzucrvklhqpthowsc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_OR_SECRET_KEY
SIM_LEGACY_JWT_SECRET=PASTE_LEGACY_JWT_SECRET

# Sim-only peppers — fresh randoms, worthless outside the sandbox:
AUTH_PIN_PEPPER=sim-pin-pepper-2026-08-11-x7f3
AUTH_PASSWORD_PEPPER=sim-password-pepper-2026-08-11-k9m2

NEXT_PUBLIC_APP_URL=http://localhost:3100
SESSION_IDLE_MINUTES=480
SELF_EDIT_WINDOW_HOURS=2
CRON_SECRET=sim-cron-secret-not-secret

# Dormant legs STAY dormant in sim (the launcher also strips these defensively):
TOAST_ENABLED=false
TWILIO_ENABLED=false
EMAIL_FROM=sim@resend.dev
